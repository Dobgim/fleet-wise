# --- Clerk authentication (see CLERK-SETUP.md) ---
# Clerk dashboard > API keys > Next.js.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server-only. Never expose to the browser.
CLERK_SECRET_KEY=sk_test_...
# Signing secret for the user.created/updated/deleted webhook. Without it the
# profiles table never fills, so reminder emails have no recipient.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Keep Clerk's redirects on the URLs this app already uses.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Supabase (Project Settings -> API) ---
# Data only — Clerk is the identity provider. Connect them in
# Supabase > Authentication > Sign In / Providers > Clerk.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (server-side only — never expose in the browser) ---
OPENAI_API_KEY=
# Optional: override the model (default gpt-4o-mini)
OPENAI_MODEL=

# --- Maintenance reminder emails (daily cron) ---
# Service role key: Supabase dashboard > Settings > API. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel sends it as the cron Authorization header.
CRON_SECRET=
# One email provider. Resend is preferred when both are set; it needs a
# verified domain. See supabase/templates/README.md for the full setup.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender address shown to users (must be on your verified domain).
EMAIL_FROM=
EMAIL_FROM_NAME=MotorWise
EMAIL_REPLY_TO=
# Used for links and the logo inside emails.
NEXT_PUBLIC_SITE_URL=https://motorwise.co

# --- Paddle payments (merchant of record: handles worldwide sales tax) ---
# Server API key: Paddle > Developer tools > Authentication (starts pdl_).
PADDLE_API_KEY=
# Notification/webhook signing secret for the endpoint you create (pdl_ntfset_).
PADDLE_WEBHOOK_SECRET=
# Leave unset (or anything but "production") to stay in Paddle's sandbox.
PADDLE_ENV=
# Client-side token: Paddle > Developer tools > Authentication. Public.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Must match PADDLE_ENV so the browser and server talk to the same Paddle.
NEXT_PUBLIC_PADDLE_ENV=
# Price IDs from Paddle > Catalog > Products (start pri_). Real checkout
# turns on automatically once the client token and both prices are set.
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=

# --- PostHog (step 10) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_RECEIPT_UPLOADS=false
