# --- Clerk authentication (see CLERK-SETUP.md) ---
# Clerk dashboard > API keys > Next.js.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server-only. Never expose to the browser.
CLERK_SECRET_KEY=sk_test_...
# Signing secret for the user.created/updated/deleted webhook. Without it the
# profiles table never fills, so reminder emails have no recipient.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Keep Clerk's redirects on the URLs this app already uses.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Supabase (Project Settings -> API) ---
# Data only — Clerk is the identity provider. Connect them in
# Supabase > Authentication > Sign In / Providers > Clerk.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (server-side only — never expose in the browser) ---
OPENAI_API_KEY=
# Optional: override the model (default gpt-4o-mini)
OPENAI_MODEL=

# --- Maintenance reminder emails (daily cron) ---
# Service role key: Supabase dashboard > Settings > API. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; the Worker's scheduled handler sends it as the cron
# Authorization header (see worker.ts).
CRON_SECRET=
# One email provider. Resend is preferred when both are set; it needs a
# verified domain. See supabase/templates/README.md for the full setup.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender address shown to users (must be on your verified domain).
EMAIL_FROM=
EMAIL_FROM_NAME=MotorWise
EMAIL_REPLY_TO=
# Used for links and the logo inside emails.
NEXT_PUBLIC_SITE_URL=https://motorwise.co

# --- Whop payments (merchant of record: handles worldwide sales tax) ---
# Whop > Developer > API keys. Needs checkout_configuration:create,
# plan:create, access_pass:create/update and membership:cancel.
WHOP_API_KEY=
# Whop > your company. Starts biz_.
WHOP_COMPANY_ID=
# Required: the product new plans are attached to. Starts prod_.
# A renewal plan cannot be created without one.
WHOP_PRODUCT_ID=
# Whop > Developer > Webhooks. Verifies every billing event.
WHOP_WEBHOOK_SECRET=
# Anything but "production" stays on Whop's sandbox API, so a mistake
# cannot charge a real card.
WHOP_ENV=

# --- PostHog (step 10) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_RECEIPT_UPLOADS=false
